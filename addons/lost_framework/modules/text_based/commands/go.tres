[resource]
script = ExtResource("1_command")
id = &"go"
name = "go"
aliases = PackedStringArray("go")
needs_direction = true
help_text = "Walk in a direction.\nA direction alone works too: \"north\" or \"n\"."
help_examples = Array[String](["go north", "n"])
help_category = "Movement"
localizations = Array[ExtResource("9_localization")]([SubResource("Localization_th")])
messages = Array[ExtResource("2_message")]([SubResource("Message_no_exit"), SubResource("Message_door_closed"), SubResource("Message_door_locked"), SubResource("Message_cant_do"), SubResource("Message_leaves"), SubResource("Message_arrives")])
metadata/_custom_type_script = "uid://dspyiq1a2i7vd"
