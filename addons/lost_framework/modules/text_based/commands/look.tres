[sub_resource type="Resource" id="Localization_th"]
script = ExtResource("9_localization")
locale = "th"
messages = Array[ExtResource("2_message")]([SubResource("Message_th_you_see"), SubResource("Message_th_exits"), SubResource("Message_th_door_open"), SubResource("Message_th_door_closed"), SubResource("Message_th_door_locked"), SubResource("Message_th_door_unlocked"), SubResource("Message_th_no_exits"), SubResource("Message_th_nowhere"), SubResource("Message_th_nothing_that_way"), SubResource("Message_th_view_blocked"), SubResource("Message_th_view_room"), SubResource("Message_th_view_contents"), SubResource("Message_th_beyond"), SubResource("Message_th_beyond_part"), SubResource("Message_th_another_room"), SubResource("Message_th_known_room"), SubResource("Message_th_cant_do")])
name = "ดู"
aliases = PackedStringArray("ดู", "มอง", "ดูไป", "มองไป")
help_text = "บอกว่าตอนนี้อยู่ที่ไหน\nใส่ทิศเพื่อดูสถานที่ถัดไปทางนั้น หรือใส่สิ่งของเพื่อสำรวจสิ่งนั้น"
help_examples = Array[String](["ดู", "มองไปทางเหนือ", "ดูกล่อง"])
metadata/_custom_type_script = "uid://dbkqe3edfftg0"

[resource]
script = ExtResource("1_command")
id = &"look"
name = "look"
aliases = PackedStringArray("look", "l", "see")
object_requirement = 1
with_object_command = &"examine"
accepts_direction = true
help_text = "Describe where you are.\nWith a direction it describes the next place that way; with a thing it examines it."
help_examples = Array[String](["look", "look north", "look box"])
help_category = "Info"
localizations = Array[ExtResource("9_localization")]([SubResource("Localization_th")])
messages = Array[ExtResource("2_message")]([SubResource("Message_room"), SubResource("Message_you_see"), SubResource("Message_exits"), SubResource("Message_exit_door"), SubResource("Message_door_open"), SubResource("Message_door_closed"), SubResource("Message_door_locked"), SubResource("Message_door_unlocked"), SubResource("Message_no_exits"), SubResource("Message_nowhere"), SubResource("Message_nothing_that_way"), SubResource("Message_view_blocked"), SubResource("Message_view_room"), SubResource("Message_view_contents"), SubResource("Message_beyond"), SubResource("Message_beyond_part"), SubResource("Message_another_room"), SubResource("Message_known_room"), SubResource("Message_cant_do")])
metadata/_custom_type_script = "uid://dspyiq1a2i7vd"
