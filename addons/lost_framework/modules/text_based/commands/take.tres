[resource]
script = ExtResource("1_command")
id = &"take"
name = "take"
aliases = PackedStringArray("take", "get")
object_requirement = 2
object_scope = 1
help_text = "Pick something up and carry it.\nIt can also take things out of an open box or a bag you carry."
help_examples = Array[String](["take sword", "get the old sword"])
help_category = "Objects"
localizations = Array[ExtResource("9_localization")]([SubResource("Localization_th")])
messages = Array[ExtResource("2_message")]([SubResource("Message_taken"), SubResource("Message_already_have"), SubResource("Message_not_portable"), SubResource("Message_cant_do")])
metadata/_custom_type_script = "uid://dspyiq1a2i7vd"
