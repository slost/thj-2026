[resource]
script = ExtResource("1_command")
id = &"open"
name = "open"
aliases = PackedStringArray("open")
object_requirement = 2
target_requirement = 1
target_scope = 2
prepositions = PackedStringArray("with")
help_text = "Open a door, a box or another container.\nWith a key, \"open door with key\" unlocks it first."
help_examples = Array[String](["open box", "open door with key"])
help_category = "Objects"
localizations = Array[ExtResource("9_localization")]([SubResource("Localization_th")])
messages = Array[ExtResource("2_message")]([SubResource("Message_opened"), SubResource("Message_opened_revealing"), SubResource("Message_unlock_and_open"), SubResource("Message_not_openable"), SubResource("Message_already_open"), SubResource("Message_locked"), SubResource("Message_cant_open_with"), SubResource("Message_key_not_carried"), SubResource("Message_wrong_key"), SubResource("Message_cant_do")])
metadata/_custom_type_script = "uid://dspyiq1a2i7vd"
