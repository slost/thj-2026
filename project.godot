; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="THJ 2026"
config/description="THJ 2026 game jam. Godot 4.8-beta1 with the Lost framework hot-swap asset pipeline."
run/main_scene="uid://dw2o45af0ufqs"
config/features=PackedStringArray("4.8", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Refs="*res://addons/lost_framework/core/autoloads/refs.gd"
Rng="*res://addons/lost_framework/core/autoloads/rng.gd"
SignalBus="*res://addons/lost_framework/core/autoloads/signal_bus.gd"
Lost="*res://addons/lost_framework/core/lost_core.gd"
Audio="*res://addons/lost_framework/modules/audio_manager/audio_manager.module.gd"
SaveManager="*res://addons/lost_framework/modules/save_manager/save_manager.module.gd"
Settings="*res://addons/lost_framework/modules/settings/settings.module.gd"
Game="*uid://ceh6cu1vv67q"
Debug="*uid://bd6cg04s5bjqe"
GUI="*uid://b2i0xnpdkp882"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[editor]

run/main_run_args="-- --assets=https://slost.github.io/thj-2026/assets/"
run/size/viewport_height=1080

[editor_plugins]

enabled=PackedStringArray("res://addons/lost_framework/plugin.cfg")

[file_customization]

folder_colors={
"res://contents/": "yellow",
"res://systems/": "red"
}

[internationalization]

locale/translations=PackedStringArray("res://contents/translations/blocks.en.translation", "res://contents/translations/blocks.th.translation")

[lost_framework]

asset_manager/remote_enabled=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.106, 0.141, 0.188, 1)
